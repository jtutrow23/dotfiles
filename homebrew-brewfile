# =============================================================================
# Apple Silicon macOS Brewfile
# =============================================================================
#
# Homebrew prefix: /opt/homebrew
#
# Install:
#   brew bundle --file=~/.dotfiles/homebrew-brewfile
#
# Check:
#   brew bundle check --file=~/.dotfiles/homebrew-brewfile
#
# Preview removals:
#   brew bundle cleanup --file=~/.dotfiles/homebrew-brewfile
#
# Runtime policy:
#   Homebrew -> system tools, CLI utilities, apps and services
#   mise     -> Node, Python, Bun, PHP and other language runtimes
#
# =============================================================================
# -----------------------------------------------------------------------------
# Shell, terminal, and navigation
# -----------------------------------------------------------------------------
brew "bash"
brew "zsh"
brew "sheldon"
brew "starship"
brew "fzf"
brew "zoxide"
brew "direnv"
brew "tmux"
brew "bottom"
brew "dust"
brew "eza"
brew "bat"
brew "fd"
brew "ripgrep"
brew "tree"
brew "watch"
brew "yazi"
# -----------------------------------------------------------------------------
# Core command-line, networking, and security tools
# -----------------------------------------------------------------------------
brew "awscli"
brew "cloudflared"
brew "coreutils"
brew "gnu-sed"
brew "grep"
brew "wget"
brew "jq"
brew "yq"
brew "gnupg"
brew "pinentry-mac"
# -----------------------------------------------------------------------------
# Git and repository tools
# -----------------------------------------------------------------------------
brew "git"
brew "gh"
brew "git-delta"
brew "git-extras"
brew "git-filter-repo"
brew "lazygit"
# -----------------------------------------------------------------------------
# Runtime and Python tooling
# -----------------------------------------------------------------------------
#
# Node, Python, Bun and PHP are intentionally NOT installed by Homebrew.
# mise owns language runtimes so global/project versions don't conflict.
#
# Example:
#   mise use -g node@lts
#   mise use -g python@3.14
#   mise use -g bun@latest
#   mise use -g php@latest
#
brew "mise"
# Fast standalone Python package/project tooling.
# Prefer this over Homebrew pipx + Homebrew Python.
brew "uv"
# -----------------------------------------------------------------------------
# Databases and local development services
# -----------------------------------------------------------------------------
brew "postgresql@17"
brew "redis"
brew "mkcert"
brew "stripe-cli"
brew "stripe-mock"
# -----------------------------------------------------------------------------
